{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": false,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": false,
        "noImplicitAny": false,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    },
    "include": ["src", "types"],
    "exclude": ["node_modules", "dist"]
}
